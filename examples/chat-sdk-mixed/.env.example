# Discord — read automatically by @chat-adapter/discord (Bun loads `.env`).
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
DISCORD_APPLICATION_ID=YOUR_BOT_APP_ID
DISCORD_PUBLIC_KEY=YOUR_BOT_PUBLIC_KEY

# Linear — read automatically by @chat-adapter/linear.
#   LINEAR_API_KEY        a personal API key (Settings → Security & Access)
#   LINEAR_WEBHOOK_SECRET the signing secret from your Linear webhook
#   LINEAR_BOT_USERNAME   the @mention that triggers the bot in issue comments
LINEAR_API_KEY=YOUR_LINEAR_API_KEY
LINEAR_WEBHOOK_SECRET=YOUR_LINEAR_WEBHOOK_SECRET
LINEAR_BOT_USERNAME=spectrum-bot

# AI — read automatically by @ai-sdk/google (only needed for ai.ts).
GOOGLE_GENERATIVE_AI_API_KEY=
