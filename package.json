{
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "turbo": "^2",
    "ultracite": "7.4.3"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check && bun run check:gen:telegram",
    "check:gen:telegram": "bun run gen:telegram && git diff HEAD --exit-code -- packages/spectrum-ts/src/providers/telegram/generated",
    "fix": "ultracite fix",
    "gen:telegram": "bun run bot-api-spec/generators/typescript.ts"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
