{
  "name": "@spectrum-ts/chat-sdk",
  "version": "5.0.0",
  "description": "chat-sdk.dev (Vercel `chat`) provider for spectrum-ts — turns any chat adapter into a narrowable Spectrum platform.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/spectrum-ts.git",
    "directory": "packages/chat-sdk"
  },
  "homepage": "https://photon.codes/spectrum",
  "bugs": {
    "url": "https://github.com/photon-hq/spectrum-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/smoke-import.mjs dist/index.js",
    "dev": "tsdown --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lru-cache": "^11.0.0",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@chat-adapter/state-memory": "^4.31.0",
    "@spectrum-ts/core": "^5.0.0",
    "chat": "^4.31.0",
    "typescript": "^5 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@chat-adapter/state-memory": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "^4.31.0",
    "@spectrum-ts/core": "workspace:*",
    "@types/bun": "latest",
    "chat": "^4.31.0",
    "tsdown": "^0.22.2"
  },
  "license": "MIT"
}
