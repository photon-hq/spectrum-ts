{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["core"],
  "boundaries": {
    "implicitDependencies": [
      "@spectrum-ts/test-support",
      "@photon-ai/spectrum-provider-imessage",
      "@photon-ai/spectrum-provider-slack",
      "@photon-ai/spectrum-provider-telegram",
      "@photon-ai/spectrum-provider-terminal",
      "@photon-ai/spectrum-provider-whatsapp-business"
    ]
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/src/index.ts",
        "$TURBO_ROOT$/packages/*/src/config.ts",
        "$TURBO_ROOT$/scripts/smoke-import.mjs",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/LICENSE"
      ]
    }
  }
}
