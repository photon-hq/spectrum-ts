{
  "name": "spectrum-ts",
  "version": "5.0.0",
  "description": "Bring agents to any interface — unified messaging SDK for TypeScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/spectrum-ts.git",
    "directory": "packages/spectrum-ts"
  },
  "homepage": "https://photon.codes/spectrum",
  "bugs": {
    "url": "https://github.com/photon-hq/spectrum-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./authoring": {
      "bun": "./src/authoring.ts",
      "types": "./src/authoring.ts",
      "default": "./dist/authoring.js"
    },
    "./internal": {
      "bun": "./src/internal.ts",
      "types": "./src/internal.ts",
      "default": "./dist/internal.js"
    },
    "./providers": {
      "bun": "./src/providers/index.ts",
      "types": "./src/providers/index.ts",
      "default": "./dist/providers/index.js"
    },
    "./providers/*": {
      "bun": "./src/providers/*/index.ts",
      "types": "./src/providers/*/index.ts",
      "default": "./dist/providers/*/index.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./authoring": {
        "types": "./dist/authoring.d.ts",
        "default": "./dist/authoring.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "./providers": {
        "types": "./dist/providers/index.d.ts",
        "default": "./dist/providers/index.js"
      },
      "./providers/*": {
        "types": "./dist/providers/*/index.d.ts",
        "default": "./dist/providers/*/index.js"
      },
      "./manifest.json": "./dist/manifest.json"
    }
  },
  "scripts": {
    "build": "bun scripts/prepare-package.ts && tsdown && node ../../scripts/smoke-import.mjs dist/index.js && bun scripts/generate-manifest.ts",
    "dev": "tsdown --watch",
    "generate:emoji": "bun scripts/generate-emoji.ts",
    "generate:manifest": "bun scripts/generate-manifest.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@photon-ai/otel": "^0.1.1",
    "@photon-ai/proto": "^0.2.4",
    "@repeaterjs/repeater": "^3.0.6",
    "marked": "^18.0.5",
    "mime-types": "^3.0.1",
    "open-graph-scraper": "^6.11.0",
    "vcf": "^2.1.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mime-types": "^3.0.1",
    "@types/vcf": "^2.0.7",
    "hotscript": "^1.0.13",
    "tsdown": "^0.22.2",
    "unicode-emoji-json": "^0.9.0"
  },
  "peerDependencies": {
    "ffmpeg-static": "^5",
    "typescript": "^5 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@photon-ai/spectrum-provider-imessage": {
      "optional": true
    },
    "@photon-ai/spectrum-provider-slack": {
      "optional": true
    },
    "@photon-ai/spectrum-provider-telegram": {
      "optional": true
    },
    "@photon-ai/spectrum-provider-terminal": {
      "optional": true
    },
    "@photon-ai/spectrum-provider-whatsapp-business": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    }
  },
  "license": "MIT"
}
